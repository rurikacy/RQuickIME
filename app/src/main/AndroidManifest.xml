<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PickerActivity" android:exported="false"
            android:taskAffinity="com.rquickime.picker" android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden" android:theme="@style/PickerTheme" />
        <service android:name=".ImeTileService" android:exported="true"
            android:icon="@drawable/ic_keyboard" android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
